# Copy to .env before running Docker Compose.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password
CORS_ORIGINS=http://localhost:5173
# Optional first-run administrator provisioning. Leave blank to disable.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
